# Your Sleeper league ID (find it in the URL at sleeper.com — https://sleeper.com/leagues/<LEAGUE_ID>/...)
SLEEPER_LEAGUE_ID=

# Where the SQLite database lives (default: ./data/league.db)
# DB_PATH=./data/league.db

# Set to "true" to have the running server re-sync from Sleeper automatically
AUTO_SYNC=false
# Minutes between automatic syncs (default 60)
AUTO_SYNC_MINUTES=60
